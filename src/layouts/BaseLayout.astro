---
// src/layouts/BaseLayout.astro
const { title = 'Media Archive', requiresAuth = true } = Astro.props;
const BASE = import.meta.env.BASE_URL || "/";

// Accept single or multiple public bases (comma-separated)
const SINGLE_BASE = (import.meta.env.PUBLIC_MEDIA_BASE || "").trim();
const MANY_BASES = (import.meta.env.PUBLIC_MEDIA_BASES || "").split(",").map(s => s.trim()).filter(Boolean);
const MEDIA_BASES = MANY_BASES.length ? MANY_BASES : (SINGLE_BASE ? [SINGLE_BASE] : []);

// Build distinct origins for <link rel="preconnect">
const MEDIA_ORIGINS = Array.from(new Set(
  MEDIA_BASES.map(b => {
    try { return new URL(b.endsWith("/") ? b : b + "/").origin; } catch { return ""; }
  }).filter(Boolean)
));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href={`${BASE}styles/global.css`} />

    <!-- Reddit previews -->
    <link rel="preconnect" href="https://preview.redd.it" crossorigin>
    <link rel="preconnect" href="https://i.redd.it" crossorigin>

    <!-- R2 worker(s) -->
    {MEDIA_ORIGINS.map((o) => <link rel="preconnect" href={o} crossorigin />)}
  </head>
  <body>
    {requiresAuth && (
      <script is:inline data-base={BASE}>
        (function(){
          try {
            var BASE = (document.currentScript && document.currentScript.dataset && document.currentScript.dataset.base) || '/';
            var norm = function(s){ return s.endsWith('/') ? s : s + '/'; };
            var isLogin = norm(location.pathname).endsWith(norm(BASE + 'login'));
            var authed = (sessionStorage.getItem('authed') === '1');
            if (!isLogin && !authed) location.replace(BASE + 'login');
          } catch (e) {}
        })();
      </script>
    )}
    <slot />
  </body>
</html>
